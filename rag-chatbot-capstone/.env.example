# Copy this file to .env and fill in your key(s). Never commit the real .env file.

# Which LLM to use for the generation step: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Required if LLM_PROVIDER=anthropic — get one at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# Required if LLM_PROVIDER=openai — get one at https://platform.openai.com
OPENAI_API_KEY=your_openai_key_here
